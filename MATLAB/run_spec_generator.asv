close all
clear
clc

fontsize = 20;              % fontsize in figures
img_max_size = 1;           % display in full screen
Ncomp = 10;                 % number of components (events) in each spectrogram
NharmonicIncomp = 3;        % maximum number of harmonics in each event
Tcomp = 150;                % time [s] of each component (event)
breakLen = 300;             % break (in samples) between each component
maxSpikeN = 10;             % maximum number of spikes
fs = 12.5;                  % sampling rate
SNR = 10;                   % signal-to-noise ratio [dB]
range = [1.5 2.1];          % fundamental frequency range
signal = [];                % empty array initialization
tcomp = (0:1/fs:Tcomp-1);   % time vetor for each component
fForMask = zeros(Ncomp,3);  % array of fundamental and harmonic frequencies for binary mask
compDevMask = 3;            % deviation in frequency bins of each component for mask design

load("LP_filter.mat");      % low-pass filter for emulating the real-life system
load("HP_filter.mat");      % high-pass filter for emulating the real-life system

nSpec = 1;                  % number of spectrograms
NFFT = 512;                 % FFT size
L = 50;                     % Gaussian window time spread (normalized)
hopsize = 10;               % STFT decimation in time
threshold = -50;            % threshold for spectrogram display
method = 'FFT';             % method for STFT calculation

a  = -0.1;                  % minimal deviation of the base frequency
b  =  0.1;                  % maximal deviation of the base frequency
nn = 5;                     % numer of subcomponents creating a single one

for n = 1:nSpec

    for i = 1:Ncomp
        Nharm(i) = randi(NharmonicIncomp);    % random number of harmonic terms
        fbase = (range(2)-range(1)) * rand(1,1) + range(1);  % random fundamental frequency from the assumed range
        if fbase > 1.8      % to avoid aliasing in harmonic terms
            Nharm(i) = 2;
        end
        comp = zeros(1,length(tcomp));  % component vector declaration
        for j = 1:Nharm(i)              % for each harmonic term
            comp = comp + (1/(j^1.5)).*cos(2*pi*fbase.*tcomp .* j); % fundamental component
            if j == 1   % fundamental component disturbance
                r = a + (b-a).*rand(nn,1);
                comp = comp + sum(1/(j^1.5).*cos(2*pi*(fbase+r).*tcomp .* j)./(j*randi(10,1)),1);
            end
            fForMask(i,j) = fbase * j;  % storing frequency for mask 
        end

        signal = [signal, zeros(1,breakLen), comp]; % component and break concatenation
    end

    peaks = randi(maxSpikeN,1);                     % random number of spikes (interference)
    wherePeaks = randi(length(signal), peaks, 1);   % random localization of spikes
    for j = 1:peaks
        signal(wherePeaks(j)) = signal(wherePeaks(j)) + 10*rand(1); % sum of signal and spikes 
    end

    signal = awgn(signal, SNR, "measured");
    signal = fftfilt(highpassFilterNum,signal); % high-pass filter to emulate the real-life recorder
    signal = fftfilt(lowpassFilterNum,signal);  % low-pass filter to emulate the real-life recorder

    % data structure for the STFT
    x.signal = signal .* 7.94E-10;              % data scaling to imitate the real-life recorder
    x.N = length(signal);
    x.fs = fs;

    S = Gab_STFT(x, NFFT, L, 0, method);        % STFT computation
    f_scale = linspace(-x.fs/2, x.fs/2, NFFT);  % frequency scale [Hz]
    % f_scale = f_scale(NFFT/2+1:end);            % only positive frequencies
    t_scale = linspace(0,x.N/x.fs,x.N)./60;     % time scale [min]
    
    mask = zeros(size(S));                      % mask declaration
    S = abs(S(NFFT/2+1:end,:));                 % STFT pruning (only positive frequencies)
    Plot_Energy(S, threshold, 0, t_scale, f_scale(NFFT/2+1:end), fontsize, img_max_size); % display spectrogram

    % mask design
    for i = 1:Ncomp
        for j = 1:Nharm(i)
            if fForMask(i,j) == 0
                continue;
            end
            [~,closestIndex] = min(abs(fForMask(i,j) - f_scale));
            tidx = i*breakLen+((i-1)*(length(tcomp)) + 1 );
            mask(closestIndex-compDevMask:closestIndex+compDevMask, tidx : tidx + (length(tcomp))) = 1;
        end
    end

    mask  = mask(NFFT/2+1:NFFT,1:length(t_scale));
    figure
    imagesc(t_scale, f_scale(NFFT/2+1:end), mask);
    set(gca,'YDir','normal')
    xlabel('t [min]','FontSize',fontsize, 'interpreter','latex')
    ylabel('f [Hz]','FontSize',fontsize, 'interpreter','latex')
    h=colorbar;title(h,'E[dB]','FontSize',fontsize, 'interpreter','latex')
    set(gca,'FontSize',fontsize);
    set(gca,'TickLabelInterpreter','latex')
    colormap("jet")
    clim([0 1])
    c = colorbar;
    c.Label.String = 'Mask value';
    c.Label.Interpreter = 'latex';
    c.TickLabelInterpreter = 'latex';

    comp = [];
    signal = [];
end
